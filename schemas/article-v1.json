{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fortæana Article v1",
  "type": "object",
  "required": ["version", "source", "article"],
  "properties": {
    "version": {"type": "string", "const": "1.0.0"},
    "source": {
      "type": "object",
      "required": ["url", "type", "ingestedAt"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "type": {"type": "string", "enum": ["NUFORC", "MUFON", "EOC", "GOV", "REDDIT", "YOUTUBE", "CITIZEN"]},
        "name": {"type": "string"},
        "ingestedAt": {"type": "string", "format": "date-time"},
        "scraperVersion": {"type": "string"},
        "tier": {"type": ["integer", "null"], "minimum": 1, "maximum": 4}
      }
    },
    "article": {
      "type": "object",
      "required": ["textSha256", "title", "url", "language", "ingestedAt"],
      "properties": {
        "textSha256": {"type": "string"},
        "title": {"type": "string"},
        "author": {"type": ["string", "null"]},
        "published": {"type": ["string", "null"], "format": "date-time"},
        "eocNumber": {"type": ["integer", "null"]},
        "url": {"type": "string", "format": "uri"},
        "textCid": {"type": ["string", "null"]},
        "pdfCid": {"type": ["string", "null"]},
        "language": {"type": "string", "minLength": 2, "maxLength": 3},
        "wordCount": {"type": "integer", "minimum": 0},
        "hasCitations": {"type": "boolean"},
        "license": {"type": "string"},
        "ingestedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
